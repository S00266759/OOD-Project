<Window x:Class="OOD_Project.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="StoreWindow" Height="500" Width="800">
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filter bar -->
            <RowDefinition Height="*"/>
            <!-- Game list/details -->
        </Grid.RowDefinitions>

        <!-- FILTER BAR -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">

            <TextBox x:Name="txtSearch"
                       Width="200"
                       Margin="5"/>
            
            <ComboBox x:Name="cbxPlatform" Width="150" Margin="5">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="PC"/>
                <ComboBoxItem Content="Xbox"/>
                <ComboBoxItem Content="Nintendo"/>
            </ComboBox>

            <ComboBox x:Name="cbxGenre" Width="150" Margin="5">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="RPG"/>
                <ComboBoxItem Content="Shooter"/>
                <ComboBoxItem Content="Adventure"/>
            </ComboBox>

            <ComboBox x:Name="cbxSort" Width="150" Margin="5">
                <ComboBoxItem Content="A-Z"/>
                <ComboBoxItem Content="Z-A"/>
            </ComboBox>

            <Button x:Name="btnSearch" 
                    Content="Search"
                    Width="100"
                    Margin="5"
                    Click="btnSearch_Click"/>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- GAME LIST -->
            <ListBox Grid.Column="0" x:Name="lstGames" Margin="5"
                     SelectionChanged="lstGames_SelectionChanged">
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="5"
                    Padding="5">

                            <StackPanel Orientation="Horizontal">

                                <!-- Game Image -->
                                <Image Source="{Binding ImagePath}"
                                       Width="100"
                                       Height="100"
                                       Margin="5"/>

                                <!-- Game Info -->
                                <StackPanel Margin="10">

                                    <TextBlock Text="{Binding Title}"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                                    <TextBlock Text="{Binding Genre}"/>

                                    <TextBlock Text="{Binding Platform}"/>

                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- GAME DETAILS -->
            <StackPanel Grid.Column="1" Margin="10" Background="#222">
                <Image x:Name="imgGame"
                         Height="180"
                         Stretch="Fill"
                         Margin="0,0,0,10"/>

                <TextBlock Foreground="White" x:Name="tblkGameTitle" Text="Game Title" FontSize="18" Margin="0,10"/>
                <TextBlock Foreground="White" x:Name="tblkGameDescription"
                           Text="Game description goes here."
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,15">
                    <Button x:Name="btnRandomGame" Content="Random Game" Width="100" Margin="5" Click="btnRandom_Click"/>
                    <Button x:Name="btnAddtoCart" Content="Add To Cart" Width="100" Margin="5" Click="btnBuy_Click"/>
                    <Button x:Name="btnViewDetails" Content="View Details" Width="100" Margin="5"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
