<Window x:Class="OOD_Project.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="StoreWindow" Height="500" Width="800">

    <Grid Margin="5" Background="#1e1e1e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filter bar -->
            <RowDefinition Height="*"/>
            <!-- Game list/details -->
        </Grid.RowDefinitions>

        <!-- FILTER BAR -->
        <StackPanel Orientation="Horizontal"
                Grid.Row="0"
                Margin="0,0,0,10">

            <TextBox x:Name="txtSearch"
                 Width="200"
                 Margin="5"
                 Background="#2a2a2a"
                 Foreground="White"
                 BorderBrush="#333"/>

            <ComboBox x:Name="cbxPlatform"
                  Width="150"
                  Margin="5"
                  Background="#2a2a2a"
                  Foreground="Black">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="PC"/>
                <ComboBoxItem Content="Xbox"/>
                <ComboBoxItem Content="Nintendo"/>
            </ComboBox>

            <ComboBox x:Name="cbxGenre"
                  Width="150"
                  Margin="5"
                  Background="#2a2a2a"
                  Foreground="Black">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="RPG"/>
                <ComboBoxItem Content="Shooter"/>
                <ComboBoxItem Content="Adventure"/>
            </ComboBox>

            <ComboBox x:Name="cbxSort"
                  Width="150"
                  Margin="5"
                  Background="#2a2a2a"
                  Foreground="Black">
                <ComboBoxItem Content="A-Z"/>
                <ComboBoxItem Content="Z-A"/>
            </ComboBox>

            <Button x:Name="btnSearch"
                Content="Search"
                Width="100"
                Margin="5"
                Background="#00ff9c"
                Foreground="Black"
                FontWeight="Bold"
                BorderThickness="0"
                Click="btnSearch_Click"/>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- GAME LIST -->
            <Border Grid.Column="0"
                Background="#2a2a2a"
                CornerRadius="12"
                Margin="5"
                Padding="5"
                BorderBrush="#333"
                BorderThickness="1">

                <ListBox x:Name="lstGames"
                     Background="Transparent"
                     Foreground="White"
                     BorderThickness="0"
                     SelectionChanged="lstGames_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#333"
                                BorderThickness="1"
                                Margin="5"
                                Padding="5"
                                Background="#1e1e1e">

                                <StackPanel Orientation="Horizontal">

                                    <Image Source="{Binding ImagePath}"
                                       Width="80"
                                       Height="80"
                                       Margin="5"/>

                                    <StackPanel Margin="10">

                                        <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="16"/>

                                        <TextBlock Text="{Binding Genre}"
                                               Foreground="Gray"/>

                                        <TextBlock Text="{Binding Platform}"
                                               Foreground="Gray"/>

                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Border>

            <!-- GAME DETAILS -->
            <Border Grid.Column="1"
                Background="#2a2a2a"
                CornerRadius="12"
                Margin="10"
                Padding="15"
                BorderBrush="#333"
                BorderThickness="1">

                <StackPanel>

                    <Image x:Name="imgGame"
                       Height="180"
                       Stretch="Uniform"
                       Margin="0,0,0,10"/>

                    <TextBlock x:Name="tblkGameTitle"
                           Text="Game Title"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10"/>

                    <TextBlock x:Name="tblkGameDescription"
                           Text="Game description goes here."
                           TextWrapping="Wrap"
                           Foreground="Gray"/>

                    <StackPanel Orientation="Horizontal"
                            Margin="0,15">

                        <Button x:Name="btnRandomGame"
                            Content="Random"
                            Width="100"
                            Margin="5"
                            Background="#444"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnRandom_Click"/>

                        <Button x:Name="btnAddtoCart"
                            Content="Add"
                            Width="100"
                            Margin="5"
                            Background="#00ff9c"
                            Foreground="Black"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="btnBuy_Click"/>

                        <Button x:Name="btnViewDetails"
                            Content="Details"
                            Width="100"
                            Margin="5"
                            Background="#444"
                            Foreground="White"
                            BorderThickness="0"/>

                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
