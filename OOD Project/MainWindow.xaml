<Window x:Class="OOD_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        xmlns:views="clr-namespace:OOD_Project.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    
    <!-- Main Menu - what the consumer will view first when loading the program --> 
  
    <!-- Grids (Margin + Rows and Columns) -->
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        
        <ContentControl x:Name="MainContent"
                    Grid.Row="1"
                    Grid.Column="0"/>


        <!-- HEADER -->
        <Border x:Name="brder_GamezExpress_header_" Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="LightGray"
                Padding="10">

            <TextBlock x:Name="tblk_GamezExpress_header_" Text="GamezExpress"
                       FontSize="24"
                       FontWeight="Bold"/>
        </Border>

        
        <!-- Featured Game feature - Middle Screen -->
        <Border x:Name="brder_FeaturedGame" Grid.Row="1"
                Grid.Column="0"
                BorderBrush="Black"
                BorderThickness="2"
                Margin="10">
            
            <TextBlock x:Name="tblk_FeaturedGame" Text="FEATURED GAME"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"/>
        </Border>

        <!-- STORE VIEW TEST AREA -->
        <!--<views:StoreView Grid.Row="1"
                     Grid.Column="0"/>-->

        <!--Side Menu/Panel-->
        <StackPanel x:Name="stckpnl_SideMenu" Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    VerticalAlignment="Center">

            <Button x:Name="btn_Store" Content="Store"
                    Height="40"
                    Margin="0,10" 
                    Click="btn_Store_Click"/>

            <Button x:Name="btn_Library" Content="My Library"
                    Height="40"
                    Margin="0,10"/>

            <Button x:Name="btn_PCs_Addons" Content="PCs / Addons "
                    Height="40"
                    Margin="0,10"/>

            <Button x:Name="btn_Account_Rewards" Content="Account / Rewards"
                    Height="40"
                    Margin="0,10"/>
            
        </StackPanel>
        
    </Grid>
</Window>
