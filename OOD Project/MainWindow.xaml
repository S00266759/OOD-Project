<Window x:Class="OOD_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    
    <!-- Main Menu - what the consumer will view first when loading the program --> 
  
    <!-- Grids (Margin + Rows and Columns) -->
    <Grid Margin="5" Background="#1e1e1e">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>


        <!-- HEADER -->
        <Border x:Name="brder_GamezExpress_header_"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#2a2a2a"
            CornerRadius="12"
            Padding="15"
            Margin="0,0,0,10"
            BorderBrush="#333"
            BorderThickness="1">

            <TextBlock x:Name="tblk_GamezExpress_header_"
                   Text="GamezExpress"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White"/>
        </Border>

        <!-- FEATURED GAME -->
        <Border x:Name="brder_FeaturedGame"
            Grid.Row="1"
            Grid.Column="0"
            Background="#2a2a2a"
            CornerRadius="12"
            Margin="10"
            Padding="15"
            BorderBrush="#333"
            BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- Game Image -->
                <Border Background="#1a1a1a"
                    CornerRadius="8"
                    Margin="5"
                    Padding="5">

                    <Image x:Name="imgFeaturedGame"
                           Stretch="UniformToFill"/>
                </Border>

                <!-- Game Details -->
                <StackPanel Grid.Column="1"
                        Margin="15">

                    <TextBlock Text="Featured Game Title"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                    <TextBlock Text="Classic shooter experience. Venture through hell as the legendary Doom Slayer through the armies of hell to save humanity."
                           TextWrapping="Wrap"
                           Foreground="Gray"
                           Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal">

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

        <!-- SIDE MENU -->
        <StackPanel x:Name="stckpnl_SideMenu"
                Grid.Row="1"
                Grid.Column="1"
                Margin="10"
                VerticalAlignment="Center">

            <Button x:Name="btn_Store"
                Content="Store"
                Height="40"
                Margin="0,10"
                Background="#2a2a2a"
                Foreground="White"
                BorderThickness="0" Click="btn_Store_Click_1"/>

            <Button x:Name="btn_Library"
                Content="My Library"
                Height="40"
                Margin="0,10"
                Background="#2a2a2a"
                Foreground="White"
                BorderThickness="0" Click="btn_Library_Click_1"/>

            <Button x:Name="btn_Account_Rewards"
                Content="Account / Rewards"
                Height="40"
                Margin="0,10"
                Background="#2a2a2a"
                Foreground="White"
                BorderThickness="0" Click="btn_Account_Rewards_Click_1"/>


        </StackPanel>
        
    </Grid>
</Window>
