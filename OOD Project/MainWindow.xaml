<Window x:Class="OOD_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        xmlns:views="clr-namespace:OOD_Project.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    
    <!-- Main Menu - what the consumer will view first when loading the program --> 
  
    <!-- Grids (Margin + Rows and Columns) -->
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>


        <!-- HEADER -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="LightGray"
                Padding="10">

            <TextBlock Text="GamezExpress"
                       FontSize="24"
                       FontWeight="Bold"/>
        </Border>

        
        <!-- Featured Game feature - Middle Screen -->
        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="Black"
                BorderThickness="2"
                Margin="10">
            
            <TextBlock Text="FEATURED GAME"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"/>
        </Border>

        <!-- STORE VIEW TEST AREA -->
        <!--<views:StoreView Grid.Row="1"
                     Grid.Column="0"/>-->

        <!--Side Menu/Panel-->
        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    VerticalAlignment="Center">

            <Button Content="Store"
                    Height="40"
                    Margin="0,10"/>

            <Button Content="My Library"
                    Height="40"
                    Margin="0,10"/>

            <Button Content="PCs / Addons "
                    Height="40"
                    Margin="0,10"/>

            <Button Content="Account / Rewards"
                    Height="40"
                    Margin="0,10"/>
            
        </StackPanel>
        
    </Grid>
</Window>
