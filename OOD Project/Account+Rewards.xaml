<Window x:Class="OOD_Project.Account_Rewards"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="Account_Rewards" Height="450" Width="800">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Account/Rewards"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Username:" FontWeight="Bold"/>
            <TextBlock x:Name="tblkUsername" Margin="0,0,0,10"/>

            <TextBlock Text="Email:" FontWeight="Bold"/>
            <TextBlock x:Name="tblkEmail" Margin="0,0,0,10"/>

            <TextBlock Text="Reward Points:" FontWeight="Bold"/>
            <TextBlock x:Name="tblkPoints" Margin="0,0,0,10"/>

            <Button Content="Redeem Reward"
                    Width="150"
                    Margin="0,10"/>

        </StackPanel>

    </Grid>
</Window>
