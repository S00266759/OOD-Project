<UserControl x:Class="OOD_Project.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OOD_Project.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="20" Background="White">


        <!-- Rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FILTER BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Margin="5" >
                <ComboBoxItem Content="Platform"/>
            </ComboBox>
            <ComboBox Grid.Column="1" Margin="5">
                <ComboBoxItem Content="Genre"/>
            </ComboBox>
            <ComboBox Grid.Column="2" Margin="5">
                <ComboBoxItem Content="Price"/>
            </ComboBox>
            <Button Grid.Column="3" Content="Search" Width="100" Margin="5"/>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Game List -->
            <Border Grid.Column="0"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Margin="5">

                <ListBox>
                    <ListBoxItem Content="Game 1"/>
                    <ListBoxItem Content="Game 2"/>
                    <ListBoxItem Content="Game 3"/>
                </ListBox>

            </Border>

            <!-- Game Details -->
            <StackPanel Grid.Column="1"
                        Margin="10">

                <!-- Image Placeholder -->
                <Rectangle Height="180"
                           Fill="LightGray"
                           Stroke="Black"/>

                <TextBlock Text="Game Title"
                           FontSize="18"
                           Margin="0,10"/>

                <TextBlock Text="Game description will appear here."
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,15">

                    <Button Content="Random Game"
                            Margin="5"/>

                    <Button Content="Add To Cart"
                            Margin="5"/>

                    <Button Content="View Details"
                            Margin="5"/>
                </StackPanel>

            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
