<Window x:Class="OOD_Project.MyLibrary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="MyLibrary" Height="450" Width="800">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="My Game Library"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- GAME LIST -->
            <ListBox x:Name="lbxLibrary"
                     Grid.Column="0"
                     Margin="5"
                     SelectionChanged="lbxLibrary_SelectionChanged"/>

            <!-- GAME DETAILS -->
            <StackPanel Grid.Column="1" Margin="10">

                <Border Height="150"
                        Background="LightGray"
                        BorderBrush="Black"
                        BorderThickness="1">
                    <TextBlock Text="Game Image"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="tblkTitle"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,10"/>

                <TextBlock x:Name="tblkGenre"
                           Margin="0,5"/>

                <TextBlock x:Name="tblkPlatform"
                           Margin="0,5"/>

                <TextBlock x:Name="tblkDate"
                           Margin="0,5"/>

            </StackPanel>

        </Grid>
    </Grid>
</Window>
